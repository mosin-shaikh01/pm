# Normalise line endings: LF in the repository and working tree.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never diff or convert.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.bmp binary
*.tif binary
*.tiff binary
*.mp4 binary
*.webm binary
*.mp3 binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# SVG is text but should not be merged line by line.
*.svg text eol=lf -diff
